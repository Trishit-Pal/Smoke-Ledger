{
  "name": "smoke-ledger-india",
  "version": "0.2.0",
  "main": "expo-router/entry",
  "scripts": {
    "setup:env": "node scripts/copy-env-if-missing.js",
    "db:push": "supabase db push",
    "functions:deploy:delete-account": "supabase functions deploy delete-account",
    "functions:deploy:audit-record": "supabase functions deploy audit-record",
    "functions:deploy:all": "npm run functions:deploy:delete-account && npm run functions:deploy:audit-record",
    "verify:backend": "node scripts/verify-backend.mjs",
    "verify:sovereignty": "node scripts/verify-sovereignty.mjs",
    "verify:delete-resignup": "node scripts/verify-delete-resignup.mjs",
    "preflight:all": "npm run verify:backend && npm run verify:sovereignty",
    "preflight:launch": "node scripts/preflight-launch.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:perf": "jest perf.integration",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "spec:test": "node --test \"scripts/spec/**/*.test.mjs\"",
    "spec:drift": "node scripts/spec/drift-check.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@hookform/resolvers": "^3.3.0",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@supabase/supabase-js": "^2.49.1",
    "dayjs": "^1.11.11",
    "expo": "~56.0.6",
    "expo-constants": "~56.0.15",
    "expo-crypto": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-linking": "~56.0.12",
    "expo-localization": "~56.0.6",
    "expo-notifications": "~56.0.14",
    "expo-router": "~56.2.7",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.14",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.51.0",
    "react-native": "^0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.14",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "^29.7.0",
    "react-test-renderer": "19.2.3",
    "ts-jest": "^29.4.4",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/src/tests/**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.claude/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@web/(.*)$": "<rootDir>/web/$1",
      "^next/server$": "<rootDir>/src/tests/__mocks__/next-server.ts",
      "^next/navigation$": "<rootDir>/src/tests/__mocks__/next-navigation.ts"
    },
    "moduleDirectories": [
      "node_modules",
      "web/node_modules"
    ],
    "globals": {
      "ts-jest": {
        "tsconfig": {
          "strict": true,
          "baseUrl": ".",
          "paths": {
            "@/*": [
              "./src/*"
            ],
            "@app/*": [
              "./app/*"
            ],
            "@web/*": [
              "./web/*"
            ]
          },
          "skipLibCheck": true,
          "ignoreDeprecations": "6.0",
          "types": [
            "jest",
            "node"
          ]
        }
      }
    }
  },
  "private": true
}
