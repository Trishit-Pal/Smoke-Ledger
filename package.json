{
  "name": "smoke-ledger-india",
  "version": "0.2.0",
  "main": "expo-router/entry",
  "scripts": {
    "setup:env": "node scripts/copy-env-if-missing.js",
    "db:push": "supabase db push",
    "functions:deploy:delete-account": "supabase functions deploy delete-account",
    "functions:deploy:audit-record": "supabase functions deploy audit-record",
    "functions:deploy:all": "npm run functions:deploy:delete-account && npm run functions:deploy:audit-record",
    "verify:backend": "node scripts/verify-backend.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@supabase/supabase-js": "^2.49.1",
    "dayjs": "^1.11.11",
    "expo": "^56.0.3",
    "expo-constants": "^56.0.14",
    "expo-crypto": "~13.0.2",
    "expo-file-system": "~17.0.1",
    "expo-haptics": "~13.0.0",
    "expo-linking": "^56.0.11",
    "expo-localization": "~15.0.0",
    "expo-notifications": "^56.0.12",
    "expo-router": "^56.2.5",
    "expo-secure-store": "~13.0.0",
    "expo-sharing": "~12.0.1",
    "expo-splash-screen": "^56.0.9",
    "expo-status-bar": "~1.12.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.51.0",
    "react-native": "^0.85.3",
    "react-native-gesture-handler": "~2.16.0",
    "react-native-reanimated": "~3.10.0",
    "react-native-safe-area-context": "4.10.0",
    "react-native-screens": "3.31.0",
    "react-native-svg": "15.2.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.10",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "^12.5.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.45",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^7.0.0",
    "jest": "^29.7.0",
    "react-test-renderer": "18.2.0",
    "ts-jest": "^29.1.2",
    "typescript": "~5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/src/tests/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@web/(.*)$": "<rootDir>/web/$1",
      "^next/server$": "<rootDir>/src/tests/__mocks__/next-server.ts",
      "^next/navigation$": "<rootDir>/src/tests/__mocks__/next-navigation.ts"
    },
    "moduleDirectories": [
      "node_modules",
      "web/node_modules"
    ],
    "globals": {
      "ts-jest": {
        "tsconfig": {
          "strict": true,
          "baseUrl": ".",
          "paths": {
            "@/*": [
              "./src/*"
            ],
            "@app/*": [
              "./app/*"
            ],
            "@web/*": [
              "./web/*"
            ]
          },
          "skipLibCheck": true
        }
      }
    }
  },
  "private": true
}
