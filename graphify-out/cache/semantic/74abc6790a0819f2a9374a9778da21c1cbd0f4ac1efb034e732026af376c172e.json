{"nodes": [{"id": "specs_living_spec_design", "label": "Living Spec System \u2014 Design Document", "file_type": "document", "source_file": "docs/superpowers/specs/2026-06-18-living-spec-system-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Trishit (with Claude)", "contributor": null}, {"id": "specs_living_spec_spec_manifest_json", "label": "Spec Manifest JSON (code-to-section map)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-18-living-spec-system-design.md", "source_location": "The core idea section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single file mapping code globs to spec sections with last_verified_commit. This enables cheap targeted updates \u2014 only changed sections are opened. The difference between an update costing 3 sections vs the entire product."}, {"id": "specs_living_spec_token_discipline", "label": "Token Discipline (section-scoped updates)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-18-living-spec-system-design.md", "source_location": "Design constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A spec that is expensive to update will rot. Every operation is section-scoped, fan-out per section, never re-reading unchanged context. Cost is bounded to changed sections \u00d7 changed files."}, {"id": "specs_living_spec_spec_tree", "label": "Spec Tree (docs/spec/ directory structure)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-18-living-spec-system-design.md", "source_location": "The spec tree section", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_living_spec_ci_drift_guard", "label": "CI Drift Guard (scripts/spec-drift-check.mjs)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-18-living-spec-system-design.md", "source_location": "The CI drift guard section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Warning-mode pre-launch (exit 0 by default, exit 1 with --strict). A blocking gate that fights rebases would cost more than it's worth pre-launch. Can be promoted post-launch by flipping one flag."}, {"id": "specs_living_spec_spec_driven_dev", "label": "Spec-Driven Development", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-18-living-spec-system-design.md", "source_location": "Why we're building this", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "From here on, the spec leads and the code follows. When the truth is scattered, every change starts with re-discovery, onboarding is slow, and it is easy to violate an invariant nobody wrote down."}, {"id": "specs_living_spec_phase2_eval_loop", "label": "Phase 2 \u2014 Skill/Agent Eval & Learning Loop", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-18-living-spec-system-design.md", "source_location": "Phasing section", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "specs_living_spec_design", "target": "specs_living_spec_spec_manifest_json", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-18-living-spec-system-design.md", "source_location": "The core idea section", "weight": 1.0}, {"source": "specs_living_spec_design", "target": "specs_living_spec_token_discipline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-18-living-spec-system-design.md", "source_location": "Design constraints", "weight": 1.0}, {"source": "specs_living_spec_design", "target": "specs_living_spec_ci_drift_guard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-18-living-s