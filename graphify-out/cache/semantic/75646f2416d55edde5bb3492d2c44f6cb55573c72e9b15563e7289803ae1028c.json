{"nodes": [{"id": "agents_dpdp_sovereignty_reviewer", "label": "DPDP Sovereignty Reviewer Agent", "file_type": "document", "source_file": ".claude/agents/dpdp-sovereignty-reviewer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_dpdp_act_2023", "label": "India DPDP Act 2023 (Digital Personal Data Protection)", "file_type": "concept", "source_file": ".claude/agents/dpdp-sovereignty-reviewer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_audit_immutability_h1", "label": "Audit-Retention Immutability (H1 Invariant)", "file_type": "rationale", "rationale": "compliance.delete rows in error_events must survive both erase and delete operations. Three enforcement layers: (1) RLS INSERT policy blocks authenticated users from writing null-user compliance rows; (2) no DELETE/UPDATE for authenticated role; (3) DB CHECK constraint user_id IS NULL when category=compliance.delete. Layer 3 was absent in live DB as of 2026-06 audit. Retaining proof-of-deletion is itself a compliance control under DPDP.", "source_file": ".claude/agents/dpdp-sovereignty-reviewer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_erase_vs_delete_semantics", "label": "Erase Data vs Delete Account Semantics", "file_type": "rationale", "rationale": "Erase (erase_account_data RPC) wipes product tables but keeps auth user and anonymizes audit rows. Delete (delete-account edge function) is a two-step flow: erase then auth.admin.deleteUser, removes auth user, cascades product data, retains compliance.delete audit event. Gated by 15-minute reauth window. Two distinct operations with different guarantees that must never be conflated.", "source_file": ".claude/agents/dpdp-sovereignty-reviewer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_consent_versioning", "label": "Consent Versioning (DPDP)", "file_type": "concept", "source_file": ".claude/agents/dpdp-sovereignty-reviewer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_export_truncation", "label": "Export Completeness with Truncation Signal", "file_type": "concept", "source_file": ".claude/agents/dpdp-sovereignty-reviewer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_audit_pepper_pii_redaction", "label": "AUDIT_PEPPER PII Redaction", "file_type": "concept", "source_file": ".claude/agents/dpdp-sovereignty-reviewer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agents_dpdp_sovereignty_reviewer", "target": "concept_dpdp_act_2023", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/agents/dpdp-sovereignty-reviewer.md", "source_location": "line 1", "weight": 1.0}, {"source": "agents_dpdp_sovereignty_reviewer", "target": "concept_audit_immutability_h1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/agents/dpdp-sovereignty-reviewer.md", "source_location": "line 31", "weight": 1.0}, {"source": "agents_dpdp_sovereignty_reviewer", "target": "concept_erase_vs_delete_semantics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/agents/dpdp-sovereignty-reviewer.md", "source_location": "line 22", "weight": 1.0}, {"source": "agents_dpdp_sovereignty_reviewer", "target": "concept_consent_versioning", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/agents/dpdp-sovereignty-reviewer.md", "source_location": "line 63", "weight": 1.0}, {"source": "agents_dpdp_sovereignty_reviewer", "target": "con