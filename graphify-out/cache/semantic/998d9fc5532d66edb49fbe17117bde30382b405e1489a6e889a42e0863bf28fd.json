{"nodes": [{"id": "spec_00_glossary", "label": "Glossary \u2014 Smoke Ledger India", "file_type": "document", "source_file": "docs/spec/00-glossary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_cigarette_log", "label": "Cigarette Log (Smoke Event Atom)", "file_type": "concept", "source_file": "docs/spec/00-glossary.md", "source_location": "glossary: Cigarette log", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_baseline", "label": "Baseline \u2014 Rolling Average Smoking Rate", "file_type": "concept", "source_file": "docs/spec/00-glossary.md", "source_location": "glossary: Baseline", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_streak", "label": "Streak \u2014 Consecutive Days Under Baseline", "file_type": "concept", "source_file": "docs/spec/00-glossary.md", "source_location": "glossary: Streak", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_milestone", "label": "Milestone \u2014 Streak and Health Progress Markers", "file_type": "concept", "source_file": "docs/spec/00-glossary.md", "source_location": "glossary: Milestone", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_goal", "label": "Goal \u2014 User-Set Reduction or Quit Target", "file_type": "concept", "source_file": "docs/spec/00-glossary.md", "source_location": "glossary: Goal", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_savings", "label": "Savings \u2014 Potential and Actual INR Savings", "file_type": "concept", "source_file": "docs/spec/00-glossary.md", "source_location": "glossary: Savings", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_insight", "label": "Insight \u2014 Rules-Based Habit Observation", "file_type": "concept", "source_file": "docs/spec/00-glossary.md", "source_location": "glossary: Insight", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_audit_pepper", "label": "AUDIT_PEPPER \u2014 Server Secret for Audit Hash Anonymisation", "file_type": "concept", "source_file": "docs/spec/00-glossary.md", "source_location": "glossary: Pepper", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A shared server-only secret mixed with user_id before SHA-256 hashing for long-lived audit rows. Allows proving a deletion happened without storing a raw UUID. Non-reversible after auth.users is purged. Rotation severs forensic continuity but strengthens anonymisation \u2014 the correct DPDP-best-effort trade-off."}, {"id": "concept_rls", "label": "Row-Level Security (RLS) \u2014 Per-Row Multi-Tenant Isolation", "file_type": "concept", "source_file": "docs/spec/00-glossary.md", "source_location": "glossary: RLS", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Postgres per-row access control enforced in the database layer, not application code. All 13 public tables have RLS enabled. (SELECT auth.uid()) scalar-subquery form evaluated once as InitPlan for performance on large log sets."}, {"id": "concept_dpdp", "label": "DPDP \u2014 India Digital Personal Data Protection Framework", "file_type": "concept", "source_file": "docs/spec/00-glossary.md", "source_location": "glossary: DPDP", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Privacy north star: real data export and erasure paths, peppered audit design to prove deletion without re-identifiable data. DPDP-best-effort posture for a pre-launch solo-operated app \u2014 not a claim of full formal compliance."}, {"id": "concept_keyset_pagination", "label": "Keyset Pagination \u2014 Cursor-Based Log Paging", "file_type": "concept", "source_file": "docs/spec/00-glossary.md", "source_location": "glossary: Keyset pagination", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses (ts_utc, id) cursor instead of OFFSET/LIMIT to stay fast at any depth and remain stable under concurrent inserts."}, {"id": "concept_18plus_gate", "label": "18+ Age Gate \u2014 Fail-Closed Adult Verification", "file_type": "concept", "source_file": "docs/spec/00-glossary.md", "source_location": "glossary: 18+ gate", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Age always derived from date of birth, never stored as a stale integer. Fails closed: unparseable or future DOB treated as not-adult. Enforced in DB trigger (handle_new_user) so auth.users INSERT is aborted for minors."}, {"id": "concept_ist_local_date", "label": "IST Local Date / Local Hour \u2014 Timezone-Safe Date Storage", "file_type": "concept", "source_file": "docs/spec/00-glossary.md", "source_location": "glossary: IST / local date / local hour", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "local_date stored as YYYY-MM-DD text to avoid timezone re-interpretation. Requires explicit ::date cast in SQL comparisons. Domain layer uses plain string math (dayShift) to avoid timezone drift."}], "edges": [{"source": "spec_00_glossary", "target": "concept_cigarette_log", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/00-glossary.md", "source_location": "glossary: Cigarette log", "weight": 1.0}, {"source": "spec_00_glossary", "target": "concept_baseline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/00-glossary.md", "source_location": "glossary: Baseline", "weight": 1.0}, {"source": "spec_00_glossary", "target": "concept_streak", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/00-glossary.md", "source_location": "glossary: Streak", "weight": 1.0}, {"source": "spec_00_glossary", "target": "concept_milestone", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/00-glossary.md", "source_location": "glossary: Milestone", "weight": 1.0}, {"source": "spec_00_glossary", "target": "concept_goal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/00-glossary.md", "source_location": "glossary: Goal", "weight": 1.0}, {"source": "spec_00_glossary", "target": "concept_savings", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/00-glossary.md", "source_location": "glossary: Savings", "weight": 1.0}, {"source": "spec_00_glossary", "target": "concept_insight", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/00-glossary.md", "source_location": "glossary: Insight", "weight": 1.0}, {"source": "spec_00_glossary", "target": "concept_audit_pepper", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/00-glossary.md", "source_location": "glossary: Pepper", "weight": 1.0}, {"source": "spec_00_glossary", "target": "concept_rls", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/00-glossary.md", "source_location": "glossary: RLS", "weight": 1.0}, {"source": "spec_00_glossary", "target": "concept_dpdp", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/00-glossary.md", "source_location": "glossary: DPDP", "weight": 1.0}, {"source": "spec_00_glossary", "target": "concept_keyset_pagination", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/00-glossary.md", "source_location": "glossary: Keyset pagination", "weight": 1.0}, {"source": "spec_00_glossary", "target": "concept_18plus_gate", "rela