{"nodes": [{"id": "spec_01_architecture", "label": "Architecture \u2014 Smoke Ledger India", "file_type": "document", "source_file": "docs/spec/01-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_domain_layer", "label": "Domain Layer \u2014 Pure TypeScript Functions (src/domain/)", "file_type": "concept", "source_file": "docs/spec/01-architecture.md", "source_location": "The five layers", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure TypeScript with no Supabase imports, no async, no side effects. Runs identically on native app, web server, and in Jest. Structural enforcement: nothing in src/domain/ does async work."}, {"id": "concept_monorepo_shared_src", "label": "Monorepo Shared src/ \u2014 Single Source of Truth for Business Logic", "file_type": "concept", "source_file": "docs/spec/01-architecture.md", "source_location": "Monorepo layout", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both React Native (Expo) and Next.js runtimes share src/ so business logic (cigarette log math) is written once and runs everywhere. @/ alias resolves to src/ on both platforms via tsconfig paths."}, {"id": "concept_repository_pattern", "label": "Repository Pattern \u2014 One File Per DB Table", "file_type": "concept", "source_file": "docs/spec/01-architecture.md", "source_location": "The five layers: Repository", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_zustand_store", "label": "Zustand Store \u2014 In-Memory Session and Auth Cache", "file_type": "concept", "source_file": "docs/spec/01-architecture.md", "source_location": "The five layers: Store", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_realtime_refresher", "label": "RealtimeRefresher \u2014 Cross-Device Data Sync via Supabase Realtime", "fil