{"nodes": [{"id": "spec_08_security_privacy", "label": "Security and Privacy \u2014 Smoke Ledger India", "file_type": "document", "source_file": "docs/spec/08-security-privacy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_security_definer_hygiene", "label": "SECURITY DEFINER + search_path Hygiene", "file_type": "concept", "source_file": "docs/spec/08-security-privacy.md", "source_location": "SECURITY DEFINER + search_path hygiene", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All SECURITY DEFINER functions pin search_path = '' to prevent search-path injection. They run with function-owner privileges; inheriting caller's search_path could allow a creative caller to shadow tables via a schema they control."}, {"id": "concept_erase_vs_delete", "label": "Erase Data vs Delete Account \u2014 Two Distinct Data Removal Operations", "file_type": "concept", "source_file": "docs/spec/08-security-privacy.md", "source_location": "Edge cases: Erase vs delete", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Erase wipes product tables and anonymises audit rows but keeps auth identity (user can re-onboard). Delete removes auth identity entirely. Ordering constraint: erase_account_data must run before auth.admin.deleteUser; if erase fails, deletion aborts."}, {"id": "concept_compliance_delete_tamper_resistance", "label": "Compliance Delete Tamper-Resistance \u2014 3-Layer error_events Protection", "file_type": "concept", "source_file": "docs/spec/08-security-privacy.md", "source_location": "Compliance delete row tamper-resistance", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Layer 1: RLS INSERT policy blocks authenticated users from inserting compliance.delete rows. Layer 2: No UPDATE/DELETE policy for authenticated \u2014 default deny. Layer 3: CHECK constraint forces user_id IS NULL when category = 'compliance.delete'. Authenticated users cannot see, create, or modify these forensic tombstones."}, {"id": "concept_reauth_gate", "label": "Re-Authentication Gate \u2014 15-Min Window for Account Deletion", "file_type": "concept", "source_file": "docs/spec/08-security-privacy.md", "source_location": "Re-authentication gate on account deletion", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blocks a stolen refresh token from being used to delete the account. Attacker would need a recent full authentication, not just a long-lived session token."}, {"id": "concept_allowed_origins", "label": "ALLOWED_ORIGINS \u2014 Edge Function CORS Allowlist", "file_type": "concept", "source_file": "docs/spec/08-security-privacy.md", "source_location": "Origin allowlist and CORS", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wildcard * only accepted when ENVIRONMENT != production. Non-browser clients (mobile, curl) send no Origin header and are accepted \u2014 bearer token is the real gate."}], "edges": [{"source": "spec_08_security_privacy", "target": "concept_rls", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/08-security-privacy.md", "source_location": "The RLS model", "weight": 1.0}, {"source": "spec_08_security_privacy", "target": "concept_security_definer_hygiene", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/08-security-privacy.md", "source_location": "SECURITY DEFINER + search_path hygiene", "weight": 1.0}, {"source": "spec_08_security_privacy", "target": "concept_dpdp", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/08-security-privacy.md", "source_location": "The DPDP export and erase RPCs", "weight": 1.0}, {"source": "spec_08_security_privacy", "target": "concept_audit_pepper", 