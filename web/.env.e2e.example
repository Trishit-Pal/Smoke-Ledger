# Copy to web/.env.e2e (gitignored) to run the authenticated / functional E2E suite.
# These point the suite at a real Supabase project and provide the service-role key
# used to seed + tear down throwaway accounts. NEVER commit the real file.
#
# Functional E2E runs against PROD per the QA plan; every seeded account is deleted
# in teardown (CASCADE), so prod stays clean. Do NOT run load/perf against prod —
# those use a local `supabase start` stack only (see docs/testing/qa-runbook.md).

# Supabase project the suite targets (prod for functional E2E).
E2E_SUPABASE_URL=https://tvcwrsglceahkjnfuzkn.supabase.co
E2E_SUPABASE_ANON_KEY=__prod_anon_key__

# Service role key — REQUIRED for seeding/teardown. Keep secret. Prod service key
# is powerful; only place it here locally, never in CI (yet).
SUPABASE_SERVICE_ROLE_KEY=__prod_service_role_key__
