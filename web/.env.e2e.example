# Copy to web/.env.e2e (gitignored) to run the authenticated / functional E2E suite.
# These point the suite at a real Supabase project and provide the service-role key
# used to seed + tear down throwaway accounts. NEVER commit the real file.
#
# Point this at a dedicated STAGING Supabase project, never production. The suite
# seeds and deletes throwaway accounts with the service-role key, which bypasses
# RLS: on a laptop or CI secret store that is full read/write/delete on every
# user's health data if it ever leaks or a teardown goes wrong. Load/perf tests
# use a local `supabase start` stack only (see docs/testing/qa-runbook.md).

# Supabase STAGING project the suite targets.
E2E_SUPABASE_URL=https://__staging_project_ref__.supabase.co
E2E_SUPABASE_ANON_KEY=__staging_anon_key__

# Service role key of the STAGING project — REQUIRED for seeding/teardown. Keep
# secret, keep it out of CI logs, and rotate it if it is ever pasted anywhere.
SUPABASE_SERVICE_ROLE_KEY=__staging_service_role_key__

# Ask the ledger: the e2e web server needs the launcher visible. The spec mocks
# /api/ledger-chat with page.route, so no ANTHROPIC_API_KEY is needed here.
LEDGER_CHAT_ENABLED=true
