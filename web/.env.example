# Public web runtime config (safe for browser exposure)
# IMPORTANT: no spaces after = (e.g. KEY=value not KEY= value)
NEXT_PUBLIC_SUPABASE_URL= 
NEXT_PUBLIC_SUPABASE_ANON_KEY= 

# Server-only (never NEXT_PUBLIC_*). Required by /api/auth/login and account-deletion edge function.
SUPABASE_SERVICE_ROLE_KEY=

# Recommended for legal/support pages
NEXT_PUBLIC_SUPPORT_EMAIL=support@smokeledger.app

# Phone OTP via MSG91 (see docs/auth/msg91-setup.md). Default `false` keeps the
# Phone OTP mode hidden in the UI; flip to `true` after the MSG91 hook is live.
NEXT_PUBLIC_PHONE_OTP_ENABLED=false

# Ask the ledger (opt-in AI reading companion). Server-only. Off unless
# LEDGER_CHAT_ENABLED=true; the launcher is hidden while it is off. Unsetting it is the kill switch.
LEDGER_CHAT_ENABLED=false
# Six keys, tried in this order (web/lib/server/ledgerChat/providers.ts); an unset key is skipped,
# and when every set key fails the reader sees a calm "couldn't be read just now".
# Free first: Groq (turn on Zero Data Retention per org; limits are per org, so use separate orgs).
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Paid fallback: Gemini keys from a BILLING-LINKED Cloud project only (the free tier trains on
# prompts and is not allowed for EU/UK readers). Limits are per project, not per key.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
# Paid last resort: OpenRouter credits; requests deny hosts that collect data.
OPENROUTER_API_KEY=
# Optional model overrides (must support tool calling). Defaults in providers.ts.
GROQ_MODEL=
GEMINI_MODEL=
OPENROUTER_MODEL=
# Safety classifier on the Groq keys (fails closed: no Groq key, or all down, means no answers).
LEDGER_CHAT_GUARD_MODEL=
LEDGER_CHAT_INJECTION_MODEL=
# Code defaults, 20 per reader and 500 overall per day. The Production launch uses 10 and 200.
LEDGER_CHAT_DAILY_CAP_USER=20
LEDGER_CHAT_DAILY_CAP_GLOBAL=500
# A vendor not named in the consent notice is refused. Keys go in Vercel, never in the repo.
