{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/lib/supabase": ["./lib/supabase/client"],
      "@/lib/secureStore": ["./lib/storage"],
      "@/lib/haptics": ["./lib/haptics"],
      "@/hooks/useTheme": ["./hooks/useTheme"],
      "@/hooks/useReduceMotion": ["./hooks/useReduceMotion"],
      "@/*": ["../src/*"],
      "@web/*": ["./*"],
      "zod": ["./node_modules/zod"],
      "dayjs": ["./node_modules/dayjs"],
      "dayjs/*": ["./node_modules/dayjs/*"],
      "zustand": ["./node_modules/zustand"],
      "@supabase/supabase-js": ["./node_modules/@supabase/supabase-js"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
