# Copy to .env for local development (never commit real secrets).
# Or run: npm run setup:env
#
# Supabase: Dashboard → Settings → API → Project URL + anon (publishable) key.
# Never put the service_role key in this file or in the Expo app.
# IMPORTANT: no spaces after = (e.g. KEY=value not KEY= value)
#
# For India-facing users, create the Supabase project in ap-south-1 (Mumbai)
# when you create a new org/project, to reduce API latency.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_publishable_key
EXPO_PUBLIC_WEB_BASE_URL=https://smokeledger.app
